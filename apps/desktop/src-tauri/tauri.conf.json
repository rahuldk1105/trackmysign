{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrackMySign",
  "version": "0.1.4",
  "identifier": "in.trackmytech.trackmysign",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrackMySign",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "DK Rahul",
    "copyright": "Copyright (c) 2026 DK Rahul",
    "homepage": "https://sign.rahuldk.in",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Sign PDFs with your USB DSC token",
    "longDescription": "TrackMySign signs PDF documents with the Digital Signature Certificate (DSC) on your USB token. Open a PDF, place your signature, enter your token PIN and save a signed copy. Your PIN and private key never leave the token.",
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "uninstallerHeaderImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "displayLanguageSelector": false,
        "startMenuFolder": "TrackMySign",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMkU4QzNGRjE0NzhEMDUKUldRRmpVZnhQNHd1Z2NnZTEycks4UjZ4ODVtNlFMazlGTUcxQVlnREFxRjl3WjRNTjJsbkg4SEcK",
      "endpoints": [
        "https://github.com/rahuldk1105/trackmysign/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "TrackMySign"
}
